[
  [ name       summary ];
  [ 'NULL'     '' ]
  [ 'OPEN'     'Opens a statement or expression' ]
  [ 'CLOSE'    'Closes a statement or expression' ]
  [ 'BEGIN'    'Opens a serialization' ] 
  [ 'END'      'Closes a serialization' ]
  [ 'DIALOGUE' 'Encloses dialogue syntax' ]
  [ 'CONFIG'   'Encloses configuration data; NUON' ]
  [ 'TURN'     'Encloses turn-specific syntax' ]
  [ 'INPUT'    'Encloses input data']
  [ 'OUTPUT'   'Encloses output data']
  [ 'PARAMETERS', 'Encloses parameters syntax']
  [ 'LANGUAGE', 'Encloses a language parameter']
  [ 'CODE',    'Encloses a source-code serialization']
  [ 'INTERFACE', 'Encloses parameters syntax']
  [ 'EVALUATE' 'Encloses an evaluation']
  [ 'EXECUTE'  'Encloses an execute operation']
  [ 'CALL'     'Encloses an call operation']
  [ 'INTERACT' 'Encloses an execute operation']
  [ 'READ'     'Encloses a read operation']
  [ 'WRITE'    'Encloses a write operation']
  [ 'TEXT'     'Text data format']
  [ 'MARKDOWN' 'Markdown data format']
  [ 'NUON'     'NUON data format']
  [ 'LIQUID'   'Liquid template data format']
  [ 'NU'       'Nu language']
  [ 'TYPEDEF'  'Serialized type definition, followed by a language or format']
  [ 'MODEL'    'Serialized documentation of a type definition contract, followed by a language or format']
  [ 'TRAIN'    'Encloses training syntax']
  [ 'PAGES'    'Encloses training pages definition syntax']
  [ 'PAGE'     'Encloses training page content syntax']
  [ 'META'     'Encloses a NUON serialization of meta information']
  [ 'ESCAPE'   'Begins an escape of Quill syntax, designating the enclosed syntax is non-valid']
  [ 'ESCAPED'  'ENDS an escape of Quill syntax, designating the enclosed syntax is non-valid']
]
